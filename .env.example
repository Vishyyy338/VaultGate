# ==============================================================================
# VaultGate Configuration (.env.example)
# Copy this file to .env to customize local or production settings.
# All settings have safe defaults built-in.
# ==============================================================================

# Reverse Proxy Binding
VAULTGATE_PROXY_HOST=0.0.0.0
VAULTGATE_PROXY_PORT=8080

# Upstream Backend Server (Internal)
VAULTGATE_UPSTREAM_HOST=127.0.0.1
VAULTGATE_UPSTREAM_PORT=8000
VAULTGATE_UPSTREAM_URL=http://127.0.0.1:8000

# Operations Console Authentication Key
VAULTGATE_ADMIN_KEY=vg_admin_sec_2026_defense

# Keystore Database Path
VAULTGATE_KEYSTORE_PATH=database/vendor_keys.json
